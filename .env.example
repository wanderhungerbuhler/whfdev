# ──────────────────────────────────────────────────────────────────────────────
# Public site — contact form
# ──────────────────────────────────────────────────────────────────────────────

# Resend (https://resend.com)
RESEND_API_KEY=

# Optional: override From address. Default is "WHFDEV <onboarding@resend.dev>"
# Once whfdev.com is verified on Resend, switch to:
# CONTACT_FROM_EMAIL="WHFDEV <talkto@whfdev.com>"
CONTACT_FROM_EMAIL=

# Optional: override destination. Default is talkto@whfdev.com
CONTACT_TO_EMAIL=


# ──────────────────────────────────────────────────────────────────────────────
# Admin panel — /admin (proposals)
# ──────────────────────────────────────────────────────────────────────────────

# Supabase Postgres connection string (Transaction pooler, port 6543).
# Project Settings → Database → Connection string → "URI" (Transaction)
# Example: postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# NextAuth (Auth.js v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical URL. Vercel sets AUTH_URL automatically from VERCEL_URL.
# Para outros hosts, defina manualmente em produção:
#   AUTH_URL=https://whfdev.com
# Em dev local pode deixar em branco — NextAuth usa http://localhost:3000.

# GitHub OAuth — Settings → Developer settings → OAuth Apps → New OAuth App
# IMPORTANTE: cada OAuth App aceita SÓ UM callback URL. Crie DUAS apps:
#
#   1) whfdev-admin (dev)
#      Homepage URL:     http://localhost:3000
#      Callback URL:     http://localhost:3000/api/auth/callback/github
#      Use no .env.local
#
#   2) whfdev-admin (prod)
#      Homepage URL:     https://whfdev.com
#      Callback URL:     https://whfdev.com/api/auth/callback/github
#      Use nas env vars do deploy (Vercel, etc.)
#
# Cada uma tem seu próprio par Client ID / Client Secret.
GITHUB_ID=
GITHUB_SECRET=

# Allowlist of GitHub emails authorised to sign in to /admin.
# Comma-separated. Required in production (sign-in fails closed without it).
ADMIN_EMAILS=whfdev@gmail.com

# Resend sender para propostas.
# IMPORTANTE: o domínio "whfdev.com" precisa estar verificado no Resend
# (Domains → Add → setar DKIM + SPF + Return-Path no DNS). Sem isso o
# envio retorna 403 "domain not verified".
# RESEND_API_KEY é compartilhada com o form de contato acima.
RESEND_FROM_EMAIL="WHFDEV <talkto@whfdev.com>"
RESEND_REPLY_TO=talkto@whfdev.com

# Supabase Storage — anexos das propostas (PDFs, imagens, etc.)
# Project Settings → API
SUPABASE_URL=
# Service role key (NUNCA expor no client). Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
# Bucket privado (criar manualmente no painel: Storage → New bucket →
# "proposal-attachments" → Private). Default abaixo é o nome esperado.
SUPABASE_BUCKET=proposal-attachments
